{
  "id": "opencode",
  "rules": [
    {
      "id": "permission_required",
      "state": "pending",
      "priority": 300,
      "region": "whole",
      "visibleBlocker": true,
      "any": [
        { "contains": ["△ Permission required"] },
        { "contains": ["Permission required"] },
        { "contains": ["Allow once"], "any": [{ "contains": ["Allow always"] }, { "contains": ["Reject"] }] }
      ]
    },
    {
      "id": "interrupt_hint_working",
      "state": "working",
      "priority": 110,
      "region": "whole",
      "visibleWorking": true,
      "any": [
        { "regex": ["esc\\s+(?:to\\s+)?interrupt"] },
        { "contains": ["ctrl+c to interrupt"] }
      ]
    },
    {
      "id": "progress_bar_working",
      "state": "working",
      "priority": 100,
      "region": "whole",
      "visibleWorking": true,
      "regex": ["(?:■|⬝){4,}"]
    },
    {
      "id": "idle_composer",
      "state": "idle",
      "priority": 90,
      "region": "tail(6)",
      "visibleIdle": true,
      "contains": ["ctrl+p commands"]
    }
  ]
}
