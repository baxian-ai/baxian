{
  "id": "codex",
  "rules": [
    {
      "id": "osc_title_blocked",
      "state": "pending",
      "priority": 1100,
      "region": "osc_title",
      "visibleBlocker": true,
      "contains": [
        "Action Required"
      ]
    },
    {
      "id": "osc_title_working",
      "state": "working",
      "priority": 1050,
      "region": "osc_title",
      "visibleWorking": true,
      "regex": [
        "(?:^| )[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏](?: |$)"
      ]
    },
    {
      "id": "transcript_viewer",
      "state": "unknown",
      "priority": 1000,
      "region": "after_last_prompt_marker",
      "skipStateUpdate": true,
      "contains": [
        "↑/↓ to scroll",
        "pgup/pgdn to",
        "home/end to jump",
        "q to quit"
      ],
      "any": [
        {
          "contains": [
            "esc to edit prev"
          ]
        },
        {
          "contains": [
            "esc/← to edit prev"
          ]
        }
      ]
    },
    {
      "id": "trust_directory",
      "state": "pending",
      "priority": 950,
      "region": "top_non_empty_lines(20)",
      "visibleBlocker": true,
      "all": [
        {
          "regex": [
            "^> You are in [^\\r\\n]+(?:\\r?\\n|$)"
          ]
        },
        {
          "regex": [
            "(?s)Do\\s+you\\s+trust\\s+the\\s+contents\\s+of\\s+this\\s+directory\\?"
          ]
        }
      ]
    },
    {
      "id": "live_strong_blocker",
      "state": "pending",
      "priority": 900,
      "region": "after_last_prompt_marker",
      "visibleBlocker": true,
      "any": [
        {
          "contains": [
            "press enter to confirm or esc to cancel"
          ]
        },
        {
          "contains": [
            "enter to submit answer"
          ]
        },
        {
          "contains": [
            "enter to submit all"
          ]
        },
        {
          "contains": [
            "allow command?"
          ]
        }
      ]
    },
    {
      "id": "weak_blocker",
      "state": "pending",
      "priority": 600,
      "region": "whole_recent",
      "any": [
        {
          "contains": [
            "[y/n]"
          ]
        },
        {
          "contains": [
            "yes (y)"
          ]
        },
        {
          "contains": [
            "do you want to"
          ],
          "any": [
            {
              "contains": [
                "yes"
              ]
            },
            {
              "contains": [
                "❯"
              ]
            }
          ]
        },
        {
          "contains": [
            "would you like to"
          ],
          "any": [
            {
              "contains": [
                "yes"
              ]
            },
            {
              "contains": [
                "❯"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "screen_working_fallback",
      "state": "working",
      "priority": 500,
      "region": "bottom_non_empty_lines(3)",
      "visibleWorking": true,
      "lineRegex": [
        "^[•◦]\\s+Working \\([^)]*esc to interrupt\\)(?: · .*)?$"
      ],
      "not": [
        {
          "contains": [
            "■ Conversation interrupted"
          ]
        }
      ]
    },
    {
      "id": "osc_title_idle",
      "state": "idle",
      "priority": 100,
      "region": "osc_title",
      "visibleIdle": true,
      "regex": [
        "\\S"
      ],
      "not": [
        {
          "regex": [
            "(?:^| )[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏](?: |$)"
          ]
        },
        {
          "contains": [
            "Action Required"
          ]
        }
      ]
    }
  ]
}
