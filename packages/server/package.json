{
  "name": "@baxian/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "baxian": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build && rm -rf dist/agent/detect/manifests && cp -r src/agent/detect/manifests dist/agent/detect/manifests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "commander": "^13.0.0",
    "fastify": "^5.0.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "ws": "^8.20.0"
  }
}
